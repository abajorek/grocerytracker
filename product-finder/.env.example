# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Reddit "script" app (free). See README for the 2-minute setup.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=product-finder/0.1 by u/your_username

# Claude API key from https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=
